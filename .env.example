# Скопируйте в .env и заполните. Незаполненная платформа просто пропускается.

# Telegram — токен от @BotFather
TELEGRAM_TOKEN=

# VK — токен сообщества (Управление → Работа с API → Ключи доступа)
# и числовой ID сообщества. В настройках Long Poll API должна быть включена
# версия API и событие "Входящее сообщение".
VK_TOKEN=
VK_GROUP_ID=

# MAX — токен от @MasterBot. Передаётся в заголовке Authorization.
MAX_TOKEN=

# Replicate — токен для генерации фотосессий (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=

# YooKassa — данные магазина для подключения платежей.
# Для теста можно использовать тестовый магазин и тестовый secret key.
# YOOKASSA_SHOP_ID — идентификатор магазина
# YOOKASSA_SECRET_KEY — секретный ключ API
# YOOKASSA_RETURN_URL — HTTPS-ссылка, куда пользователь вернётся после оплаты
# (например, https://t.me/your_bot_username)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
